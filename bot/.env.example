# Bot environment variables
# Copy this file to .env and fill in your values. Never commit .env.

# Twilio WhatsApp Sandbox credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The Twilio sandbox WhatsApp number (format: whatsapp:+14155238886)
TWILIO_WHATSAPP_NUMBER=

# Backend API base URL (where your backend is deployed, e.g. https://dialsafe-api.onrender.com)
BACKEND_URL=http://localhost:3000

# Shared secret for bypassing backend rate-limit (must match backend's BOT_API_KEY)
BOT_API_KEY=change-me

# Port for this bot server to listen on
PORT=4000

# Frontend URL (for building detail links in replies)
FRONTEND_URL=http://localhost:5173

# Set to 'true' in development to skip Twilio signature validation
SKIP_TWILIO_VALIDATION=false
